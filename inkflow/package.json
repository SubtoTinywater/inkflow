{
  "name": "inkflow-studio",
  "version": "1.0.0",
  "description": "Drawing and frame-animation studio with an MCP bridge so AI assistants can draw and animate.",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "mcp": "node mcp/server.mjs",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "android:sync": "cap add android && cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.inkflow.studio",
    "productName": "InkFlow Studio",
    "files": [
      "main.cjs",
      "www/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ],
      "artifactName": "InkFlow-Studio-${version}.${ext}"
    },
    "dmg": {
      "title": "InkFlow Studio"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "InkFlow-Studio-Setup-${version}.${ext}"
    }
  }
}